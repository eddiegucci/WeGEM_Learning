rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== USERS =====================
    // Users can read/write their own profile + attempts
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if isAdmin();
      }
    }

    // ===================== QUESTIONS =====================
    // Read by any signed-in user; write by admins only
    match /questions/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ===================== NOTES =====================
    // Read by any signed-in user; write by admins only
    match /notes/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ===================== EXAM LINKS =====================
    // Any signed-in user can add/edit; only creator or admin can delete
    match /examLinks/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ===================== CONTENT META =====================
    // Read by any signed-in user; write by admins only
    match /contentMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ===================== LEADERBOARD =====================
    // Read by any signed-in user; write by owner only
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ===================== ACTIVITY LOG =====================
    // Read by admins; anyone signed in can write
    match /activity/{docId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    // ===================== HELPERS =====================
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}