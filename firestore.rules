rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== HELPERS =====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===================== USERS =====================
    match /users/{userId} {
      // Any signed-in user can read user docs (needed for leaderboard lookups)
      allow read: if isSignedIn();

      // On create: user can only create their own doc, role must be "student"
      allow create: if isSelf(userId)
                    && request.resource.data.role == 'student';

      // On update: admins can update any user (promote/demote),
      // OR users can update their own doc — but only if role stays the same
      allow update: if isAdmin()
                    || (isSelf(userId)
                        && request.resource.data.role == resource.data.role);

      // Only admins can delete user docs
      allow delete: if isAdmin();

      // Attempts subcollection
      match /attempts/{attemptId} {
        allow read: if isSignedIn();
        allow create: if isSelf(userId);
        allow update, delete: if isAdmin();
      }
    }

    // ===================== QUESTIONS =====================
    match /questions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===================== NOTES =====================
    match /notes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin()
                            || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /files/{fileId} {
     allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    } 
    
    // ===================== EXAM LINKS =====================
    match /examLinks/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin()
                            || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ===================== CONTENT META =====================
    match /contentMeta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ===================== LEADERBOARD =====================
    match /leaderboard/{userId} {
      allow read: if isSignedIn();

      // On create: user can only create their own entry, starting from 0
      allow create: if isSelf(userId)
                    && request.resource.data.totalScore == 0;

      // On update: user can only update their own entry,
      // and can't inflate totalScore by more than 100 per write
      allow update: if isSelf(userId)
                    && request.resource.data.totalScore >= resource.data.totalScore
                    && request.resource.data.totalScore <= resource.data.totalScore + 100;

      allow delete: if isAdmin();
    }

    // ===================== ACTIVITY LOG =====================
    match /activity/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }
  }
}