{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["status", "createdAt", "hostUid"],
        "questions": { ".read": "auth != null" },
        "settings": { ".read": "auth != null" },
        "status": { ".read": "auth != null" },
        "currentQuestionIndex": { ".read": "auth != null" },
        "code": { ".read": "auth != null" },
        "hostUid": { ".read": "auth != null" },
        "createdAt": { ".read": "auth != null" },
        "startedAt": { ".read": "auth != null" },
        "finishedAt": { ".read": "auth != null" },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "answers": {
              ".read": "auth != null"
            }
          }
        }
      }
    }
  }
}