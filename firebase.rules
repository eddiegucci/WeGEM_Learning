{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".indexOn": ["status", "createdAt", "hostUid"],

        "status": {
          ".write": "auth != null && (
            !data.exists() ||
            root.child('rooms').child($roomCode).child('hostUid').val() == auth.uid
          )"
        },
        "currentQuestionIndex": {
          ".write": "auth != null && (
            !data.exists() ||
            root.child('rooms').child($roomCode).child('hostUid').val() == auth.uid
          )"
        },
        "startedAt": {
          ".write": "auth != null && (!data.exists() || root.child('rooms').child($roomCode).child('hostUid').val() == auth.uid)"
        },
        "finishedAt": {
          ".write": "auth != null && (!data.exists() || root.child('rooms').child($roomCode).child('hostUid').val() == auth.uid)"
        },

        "questions": {
          ".write": "auth != null && !data.exists()"
        },
        "settings": {
          ".write": "auth != null && !data.exists()"
        },
        "code": {
          ".write": "auth != null && !data.exists()"
        },
        "hostUid": {
          ".write": "auth != null && !data.exists()"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            "answers": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid == $uid"
              }
            }
          }
        }
      }
    }
  }
}